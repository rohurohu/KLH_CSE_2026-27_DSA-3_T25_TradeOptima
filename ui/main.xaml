<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="TradeOptima" Width="1320" Height="900" MinWidth="1100" MinHeight="740" WindowStartupLocation="CenterScreen"
 Background="#F4F6F8" FontFamily="Segoe UI" FontSize="13" Foreground="#162D34">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="14,10"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Background" Value="#FFFFFF"/>
   <Setter Property="Foreground" Value="#18383D"/><Setter Property="BorderBrush" Value="#D8E2E4"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Opacity" Value="0.82"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shell" Property="Opacity" Value="0.45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="#007C72"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="#153C41"/><Setter Property="Foreground" Value="#DAE9E8"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Margin" Value="0,0,0,7"/>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="9,7"/><Setter Property="BorderBrush" Value="#CCDADB"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="8,7"/><Setter Property="MinHeight" Value="34"/></Style>
  <Style TargetType="DataGrid">
   <Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/>
   <Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#EAF0F1"/>
   <Setter Property="HeadersVisibility" Value="Column"/><Setter Property="Background" Value="White"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="RowHeight" Value="34"/><Setter Property="AlternatingRowBackground" Value="#F8FAFB"/><Setter Property="ColumnHeaderHeight" Value="36"/>
   <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/><Setter Property="MinHeight" Value="80"/>
  </Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#F0F5F5"/><Setter Property="Padding" Value="12,8"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="Padding" Value="12,4"/><Setter Property="BorderThickness" Value="0"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
 </Window.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="254"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#103238">
   <DockPanel Margin="20,26,20,20">
    <StackPanel DockPanel.Dock="Top">
     <TextBlock Text="TRADEOPTIMA" Foreground="White" FontSize="22" FontWeight="Bold"/>
     <TextBlock Text="ALGORITHM LAB / DSA-3" Foreground="#91B5B6" FontSize="10" Margin="1,5,0,25"/>
     <Button x:Name="AnalysisNav" Content="01   Stock analysis" Style="{StaticResource Nav}" Background="#007C72"/>
     <Button x:Name="ReplayNav" Content="02   Market replay" Style="{StaticResource Nav}"/>
     <Button x:Name="VerifyNav" Content="03   Verification" Style="{StaticResource Nav}"/>
     <Border Height="1" Background="#315258" Margin="0,15,0,17"/>
    </StackPanel>
    <TextBlock DockPanel.Dock="Bottom" Text="Runs locally on your PC.&#10;No broker connection or real orders." Foreground="#91B5B6" FontSize="11" TextWrapping="Wrap" Margin="0,16,0,0"/>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel>
      <StackPanel x:Name="FilePanel">
       <TextBlock Text="PRICE DATA" Foreground="#9DBABB" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>
       <TextBlock x:Name="FileLabel" Text="Bundled historical dataset" Foreground="White" TextWrapping="Wrap" Margin="0,0,0,10"/>
       <Button x:Name="ImportButton" Content="Import a CSV..." Margin="0,0,0,6"/>
       <Button x:Name="SampleButton" Content="Use bundled sample" Background="#153C41" Foreground="White" BorderBrush="#3B6265" Margin="0,0,0,14"/>
       <TextBlock Text="Stock / price column" Foreground="#C2D6D7" Margin="0,0,0,5"/>
       <ComboBox x:Name="ColumnCombo" Margin="0,0,0,12"/>
       <TextBlock Text="Display currency" Foreground="#C2D6D7" Margin="0,0,0,5"/>
       <ComboBox x:Name="CurrencyCombo" SelectedIndex="0" Margin="0,0,0,14"><ComboBoxItem Content="USD"/><ComboBoxItem Content="INR"/></ComboBox>
      </StackPanel>
      <StackPanel x:Name="SettingsPanel">
       <TextBlock Text="ANALYSIS SETTINGS" Foreground="#9DBABB" FontSize="10" FontWeight="Bold" Margin="0,4,0,10"/>
       <TextBlock Text="Maximum completed trades" Foreground="#C2D6D7" Margin="0,0,0,5"/>
       <TextBox x:Name="TradesInput" Text="3" Margin="0,0,0,10"/>
       <Grid Margin="0,0,0,12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="Fee per trade" Foreground="#C2D6D7" Margin="0,0,0,5"/><TextBox x:Name="FeeInput" Text="0.50"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="Cooldown days" Foreground="#C2D6D7" Margin="0,0,0,5"/><TextBox x:Name="CooldownInput" Text="1"/></StackPanel>
       </Grid>
      </StackPanel>
      <StackPanel x:Name="BudgetPanel" Visibility="Collapsed">
       <TextBlock Text="Daily budget (USD)" Foreground="#C2D6D7" Margin="0,0,0,5"/><TextBox x:Name="BudgetInput" Text="200.00" Margin="0,0,0,10"/>
       <TextBlock Text="Analysis window (days)" Foreground="#C2D6D7" Margin="0,0,0,5"/><TextBox x:Name="WindowInput" Text="60" Margin="0,0,0,14"/>
       <TextBlock Text="Four historical stocks. Synthetic news and venue books. Budget resets each day." Foreground="#A9C2C3" TextWrapping="Wrap" FontSize="11"/>
      </StackPanel>
      <Button x:Name="RunButton" Content="Analyze stock" Style="{StaticResource Primary}" Margin="0,10,0,0" Padding="14,13"/>
     </StackPanel>
    </ScrollViewer>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="30,24,30,16">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,20">
    <StackPanel>
     <TextBlock x:Name="PageTitle" Text="Stock analysis" FontSize="29" FontWeight="SemiBold"/>
     <TextBlock x:Name="PageSubtitle" Text="Explore historical prices, optimal trades and risk in one place." Foreground="#647B82" Margin="0,7,0,0"/>
    </StackPanel>
    <Border Background="#E3EFEB" CornerRadius="5" Padding="11,6" HorizontalAlignment="Right" VerticalAlignment="Top"><TextBlock Text="HISTORICAL / PAPER ONLY" Foreground="#35645A" FontSize="10" FontWeight="SemiBold"/></Border>
   </Grid>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid>
     <StackPanel x:Name="AnalysisPage">
      <TextBlock x:Name="DataSummary" Text="Choose a price column and select Analyze stock. You can also import your own CSV." Foreground="#526F76" Margin="0,0,0,14" TextWrapping="Wrap"/>
      <UniformGrid Columns="4" Margin="0,0,-10,16">
       <Border Background="White" CornerRadius="8" Padding="16" Margin="0,0,10,0"><StackPanel><TextBlock Text="HINDSIGHT NET PROFIT" Foreground="#6F8388" FontSize="10"/><TextBlock x:Name="ProfitText" Text="—" Foreground="#007C72" FontSize="27" FontWeight="SemiBold" Margin="0,6,0,0"/><TextBlock x:Name="ProfitUnit" Text="One share at a time" Foreground="#75898D" FontSize="11"/></StackPanel></Border>
       <Border Background="White" CornerRadius="8" Padding="16" Margin="0,0,10,0"><StackPanel><TextBlock Text="COMPLETED TRADES" Foreground="#6F8388" FontSize="10"/><TextBlock x:Name="TradesText" Text="—" FontSize="27" FontWeight="SemiBold" Margin="0,6,0,0"/><TextBlock x:Name="LegalText" Text="Ledger awaits analysis" Foreground="#75898D" FontSize="11"/></StackPanel></Border>
       <Border Background="White" CornerRadius="8" Padding="16" Margin="0,0,10,0"><StackPanel><TextBlock Text="LATEST CLOSE" Foreground="#6F8388" FontSize="10"/><TextBlock x:Name="CloseText" Text="—" FontSize="27" FontWeight="SemiBold" Margin="0,6,0,0"/><TextBlock x:Name="LastDateText" Text="From your dataset" Foreground="#75898D" FontSize="11"/></StackPanel></Border>
       <Border Background="White" CornerRadius="8" Padding="16" Margin="0,0,10,0"><StackPanel><TextBlock Text="95% ONE-DAY VaR" Foreground="#6F8388" FontSize="10"/><TextBlock x:Name="RiskText" Text="—" FontSize="27" FontWeight="SemiBold" Margin="0,6,0,0"/><TextBlock x:Name="CvarText" Text="For one share" Foreground="#75898D" FontSize="11"/></StackPanel></Border>
      </UniformGrid>
      <Border Background="White" CornerRadius="9" Padding="18,15,18,8" Margin="0,0,0,16">
       <StackPanel>
        <Grid><TextBlock Text="Price history &amp; optimal trades" FontSize="16" FontWeight="SemiBold"/><TextBlock HorizontalAlignment="Right"><Run Text="● Buy     " Foreground="#007C72"/><Run Text="● Sell" Foreground="#DA8252"/></TextBlock></Grid>
        <Canvas x:Name="PriceChart" Height="245" ClipToBounds="True" Margin="0,8,0,0"/>
        <TextBlock Text="The chart is an overview. Buy and sell markers come from the complete Java trade ledger." Foreground="#7B8D91" FontSize="10" Margin="0,0,0,5"/>
       </StackPanel>
      </Border>
      <Border Background="White" CornerRadius="9" Padding="18" Margin="0,0,0,14">
       <StackPanel>
        <Grid Margin="0,0,0,10"><TextBlock Text="Trade ledger" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/><Button x:Name="ExportButton" Content="Export ledger..." HorizontalAlignment="Right" Padding="12,6" IsEnabled="False"/></Grid>
        <DataGrid x:Name="LedgerGrid" Height="180">
         <DataGrid.Columns>
          <DataGridTextColumn Header="Buy date" Binding="{Binding BuyDate}" Width="*"/>
          <DataGridTextColumn Header="Buy price" Binding="{Binding BuyPrice}" Width="*"/>
          <DataGridTextColumn Header="Sell date" Binding="{Binding SellDate}" Width="*"/>
          <DataGridTextColumn Header="Sell price" Binding="{Binding SellPrice}" Width="*"/>
          <DataGridTextColumn Header="Net profit" Binding="{Binding NetProfit}" Width="*"/>
         </DataGrid.Columns>
        </DataGrid>
        <TextBlock x:Name="LedgerNote" Text="Trades will appear here after analysis." Foreground="#647B82" FontSize="11" Margin="0,9,0,0" TextWrapping="Wrap"/>
       </StackPanel>
      </Border>
      <TextBlock Text="Hindsight optimization uses the entire selected history. It is not a future trading signal. Risk uses historical returns and excludes fees." Foreground="#647B82" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
     </StackPanel>
     <StackPanel x:Name="ReplayPage" Visibility="Collapsed">
      <Border Background="#E7F1EF" CornerRadius="8" Padding="15" Margin="0,0,0,16"><TextBlock Text="All five modules, one observed day at a time. News and order books are synthetic fixtures; each day is a fresh paper allocation." Foreground="#396761" TextWrapping="Wrap"/></Border>
      <Grid Margin="0,0,0,12">
       <TextBlock x:Name="ReplayDate" Text="Load the replay to begin" FontSize="22" FontWeight="SemiBold"/>
       <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="PrevButton" Content="Previous" Padding="12,7" IsEnabled="False"/>
        <Button x:Name="PlayButton" Content="Play" Style="{StaticResource Primary}" Padding="18,7" Margin="7,0" IsEnabled="False"/>
        <Button x:Name="NextButton" Content="Next" Padding="12,7" IsEnabled="False"/>
       </StackPanel>
      </Grid>
      <Slider x:Name="DaySlider" Minimum="0" Maximum="1" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" IsEnabled="False" Margin="0,0,0,4"/>
      <TextBlock x:Name="ReplayPosition" Text="Use the slider to inspect an observed day." Foreground="#73898E" FontSize="11" Margin="0,0,0,16"/>
      <UniformGrid Columns="4" Margin="0,0,-10,16">
       <Border Background="White" CornerRadius="8" Padding="16" Margin="0,0,10,0"><StackPanel><TextBlock Text="ROUTED COST / USD" Foreground="#6F8388" FontSize="10"/><TextBlock x:Name="SpendText" Text="—" Foreground="#007C72" FontSize="26" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel></Border>
       <Border Background="White" CornerRadius="8" Padding="16" Margin="0,0,10,0"><StackPanel><TextBlock Text="BASKET VALUE / USD" Foreground="#6F8388" FontSize="10"/><TextBlock x:Name="BasketText" Text="—" FontSize="26" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel></Border>
       <Border Background="White" CornerRadius="8" Padding="16" Margin="0,0,10,0"><StackPanel><TextBlock Text="95% ONE-DAY VaR / USD" Foreground="#6F8388" FontSize="10"/><TextBlock x:Name="ReplayRiskText" Text="—" FontSize="26" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel></Border>
       <Border Background="White" CornerRadius="8" Padding="16" Margin="0,0,10,0"><StackPanel><TextBlock Text="NEW HEADLINES" Foreground="#6F8388" FontSize="10"/><TextBlock x:Name="NewsText" Text="—" FontSize="26" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel></Border>
      </UniformGrid>
      <Border Background="White" CornerRadius="9" Padding="18" Margin="0,0,0,16"><StackPanel>
       <TextBlock Text="Search, trade analysis &amp; portfolio selection" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
       <DataGrid x:Name="AssetsGrid" Height="182"><DataGrid.Columns>
        <DataGridTextColumn Header="Stock" Binding="{Binding Stock}" Width="*"/><DataGridTextColumn Header="Close (USD)" Binding="{Binding Close}" Width="*"/>
        <DataGridTextColumn Header="News mentions" Binding="{Binding Mentions}" Width="*"/><DataGridTextColumn Header="Window profit" Binding="{Binding Profit}" Width="*"/>
        <DataGridTextColumn Header="Portfolio" Binding="{Binding Selection}" Width="*"/>
       </DataGrid.Columns></DataGrid>
       <TextBlock x:Name="SelectionNote" Text="Selection uses a classroom utility score, not a return forecast." Foreground="#647B82" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/>
      </StackPanel></Border>
      <Border Background="White" CornerRadius="9" Padding="18"><StackPanel>
       <TextBlock Text="Cross-venue paper routing" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
       <DataGrid x:Name="FillsGrid" Height="155"><DataGrid.Columns>
        <DataGridTextColumn Header="Stock" Binding="{Binding Stock}" Width="*"/><DataGridTextColumn Header="Venue" Binding="{Binding Venue}" Width="*"/>
        <DataGridTextColumn Header="Shares" Binding="{Binding Shares}" Width="*"/><DataGridTextColumn Header="Cost per share (USD)" Binding="{Binding UnitCost}" Width="*"/>
       </DataGrid.Columns></DataGrid>
       <TextBlock x:Name="ReplayRiskNote" Text="Risk becomes available after at least two observed returns." Foreground="#647B82" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/>
      </StackPanel></Border>
     </StackPanel>
     <StackPanel x:Name="VerificationPage" Visibility="Collapsed">
      <Border Background="White" CornerRadius="9" Padding="24"><StackPanel>
       <TextBlock Text="Check the algorithms" FontSize="22" FontWeight="SemiBold"/>
       <TextBlock Text="Run the built-in randomized reference tests, or measure the core optimizer against the two-second target." Foreground="#647B82" TextWrapping="Wrap" Margin="0,10,0,20"/>
       <StackPanel Orientation="Horizontal"><Button x:Name="TestsButton" Content="Run correctness tests" Style="{StaticResource Primary}" Margin="0,0,10,0"/><Button x:Name="BenchmarkButton" Content="Run 100,000-price benchmark"/></StackPanel>
       <TextBox x:Name="TestOutput" Text="Results will appear here.&#10;&#10;The original algorithms run in Java. This Windows interface handles only controls, file selection and display." IsReadOnly="True" FontFamily="Consolas" FontSize="13" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="350" Margin="0,22,0,0" Background="#F7FAFA"/>
       <TextBlock Text="Correctness tests include brute-force comparisons, CSV validation and replay isolation. Benchmark timing depends on your PC and its current load." Foreground="#647B82" TextWrapping="Wrap" FontSize="11" Margin="0,14,0,0"/>
      </StackPanel></Border>
      <Button x:Name="GuideButton" Content="Open the project guide" HorizontalAlignment="Left" Margin="0,16,0,0"/>
     </StackPanel>
    </Grid>
   </ScrollViewer>
   <StackPanel Grid.Row="2" Margin="0,12,0,0">
    <ProgressBar x:Name="BusyBar" Height="3" Visibility="Collapsed" IsIndeterminate="True" Foreground="#007C72" Margin="0,0,0,8"/>
    <TextBlock x:Name="StatusText" Text="Ready. Start with the bundled AAPL data, or import a CSV." Foreground="#647B82" FontSize="12" TextWrapping="Wrap"/>
   </StackPanel>
  </Grid>
 </Grid>
</Window>
